{
  "db_config": {
    "hostname": "http://tigergraph",
    "restppPort": "14240",
    "gsPort": "14240",
    "default_timeout": 300,
    "default_mem_threshold": 5000,
    "default_thread_limit": 8
  },
  "graphrag_config": {
    "reuse_embedding": true,
    "ecc": "http://graphrag-ecc:8001",
    "chat_history_api": "http://chat-history:8002",
    "chunker_config": {}
  },
  "llm_config": {
    "token_limit": 0,
    "authentication_configuration": {
      "OPENAI_API_KEY": "YOUR_OPENAI_API_KEY",
      "OPENROUTER_API_KEY": "YOUR_OPENROUTER_API_KEY"
    },
    "embedding_service": {
      "model_name": "text-embedding-3-small",
      "embedding_model_service": "openai"
    },
    "completion_service": {
      "llm_service": "openai",
      "llm_model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "openai_api_base": "https://openrouter.ai/api/v1",
      "model_kwargs": {
        "temperature": 0
      },
      "prompt_path": "./common/prompts/openai_gpt4/"
    },
    "multimodal_service": {
      "llm_service": "openai",
      "llm_model": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
      "openai_api_base": "https://openrouter.ai/api/v1",
      "model_kwargs": {
        "temperature": 0
      }
    },
    "openrouter_model_roles": {
      "orchestrator": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "tool_agent": "qwen/qwen3-coder-480b-a35b:free",
      "main_rag": "qwen/qwen3-next-80b-a3b-instruct:free",
      "evidence_generation": "google/gemma-4-31b-it:free",
      "lightweight_agent": "google/gemma-4-26b-a4b-it:free",
      "agentic_reasoning": "nex-agi/nex-n2.5-pro:free",
      "baseline": "meta-llama/llama-3.3-70b-instruct:free",
      "experimental": "dots-studio/dots-3-note-preview:free",
      "multimodal": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
    }
  },
  "chat_config": {
    "apiPort": "8002",
    "dbPath": "chats.db",
    "dbLogPath": "db.log",
    "logPath": "requestLogs.jsonl",
    "conversationAccessRoles": [
      "superuser",
      "globaldesigner"
    ]
  }
}
