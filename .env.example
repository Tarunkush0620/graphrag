# ==============================================================================
# TigerGraph Agentic GraphRAG Research Platform Configuration
# ==============================================================================

# LLM Gateway (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Configurable Model Roles
LLM_MODEL_ORCHESTRATOR=nex-agi/nex-n2.5-pro:free
LLM_MODEL_REASONING=nvidia/nemotron-3.5-lightning:free
LLM_MODEL_EXTRACTION=liquid/lfm-2.5-2.6b:free
LLM_MODEL_EVALUATION=z-ai/glm-5.2:free

# TigerGraph Database Configuration
TIGERGRAPH_HOST=http://127.0.0.1:9000
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH_NAME=olympic_qa_graph
TIGERGRAPH_TOKEN=

# Agent Execution Limits
MAX_AGENT_STEPS=8
AGENT_CONFIDENCE_THRESHOLD=0.85

# Vector Storage
VECTOR_STORE_TYPE=in_memory
EMBEDDING_DIMENSION=64
